# Copy values into your shell or deployment environment; Spring does not load this file automatically.
SPRING_PROFILES_ACTIVE=dev

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=photobuddy
DB_USERNAME=photobuddy
DB_PASSWORD=1234

# Generate a unique Base64-encoded random key of at least 32 bytes.
JWT_SECRET=QmFzZTY0U2VjcmV0S2V5VG9rZW5Gb3JQaG90b0J1ZGR5U2VydmljZQ==
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIRECTORY=./uploads
PUBLIC_API_BASE_URL=http://localhost:8080

# Production-only alternatives. Set these in the hosting platform's secret manager.
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:mysql://db-host:3306/photobuddy?serverTimezone=UTC
# CLOUDINARY_CLOUD_NAME=replace-me
# CLOUDINARY_API_KEY=replace-me
# CLOUDINARY_API_SECRET=replace-me
